{
  "name": "idea-dump",
  "version": "0.8.2",
  "private": true,
  "scripts": {
    "predev": "npm install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run tests/unit --config vitest.config.ts",
    "test:api": "vitest run tests/api --config vitest.config.ts",
    "test:db": "vitest run tests/db --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:ci": "npm run lint && npm run build && npm run test && npm run test:api && npm run test:db && playwright test --project=chromium --grep \"@smoke\"",
    "test:nightly": "npm run test && npm run test:api && npm run test:db && playwright test",
    "qa": "node scripts/qa-runner.mjs --mode full",
    "qa:smoke": "node scripts/qa-runner.mjs --mode smoke",
    "qa:fix-context": "node scripts/qa-runner.mjs --fix-context"
  },
  "dependencies": {
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.312.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.4.33",
    "supabase": "^2.109.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
}
